# SpendWise Environment Configuration Example
# Copy this to .env or backend/.env

NODE_ENV=development
PORT=5000

# MongoDB URI (Supports replica sets for multi-document ACID transactions)
# For local replica set: mongodb://127.0.0.1:27017/spendwise?replicaSet=rs0
# For standalone local: mongodb://127.0.0.1:27017/spendwise
MONGO_URI=mongodb://127.0.0.1:27017/spendwise

# JWT & Security
JWT_SECRET=spendwise_super_secure_jwt_secret_change_in_production_32chars!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=spendwise_cookie_secret_change_in_production_32chars!

# CORS & Client
CLIENT_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880
